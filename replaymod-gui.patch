+    /**
+     * Decides whether a container-GUI packet (see {@link #GUI_PACKETS}) is forwarded to the client.
+     * @param p One of the packets in {@link #GUI_PACKETS}
+     * @return The packet if it shall be sent, {@code null} otherwise
+     */
+    private Packet processGuiPacket(Packet p) {
+        if (isHurrying()) {
+            // While jumping through the replay, packets are rushed; don't open/update any GUIs, and
+            // get rid of a GUI which may be left over from before the jump.
+            if (replayGuiOpen) {
+                replayGuiOpen = false;
+                ReplayMod.instance.runLater(() -> { mc.openScreen(null); });
+            }
+            return null;
+        }
+
+        if (p instanceof CloseScreenS2CPacket) {
+            if (!replayGuiOpen) {
+                return null; // not our GUI, don't close whatever else is open
+            }
+            replayGuiOpen = false;
+            return p;
+        }
+
+        if (p instanceof ScreenHandlerSlotUpdateS2CPacket || p instanceof ScreenHandlerPropertyUpdateS2CPacket) {
+            return replayGuiOpen ? p : null;
+        }
+
+        // Remaining packets open a GUI (crafting table, chest, ...); don't replace any other screen
+        if (mc.currentScreen != null) {
+            return null;
+        }
+        replayGuiOpen = true;
+        return p;
+    }
